{
  "name": "tree-sitter-groovy",
  "version": "0.1.0",
  "description": "Groovy grammar for tree-sitter",
  "repository": "https://github.com/loganprice/tree-sitter-groovy",
  "license": "MIT",
  "main": "bindings/node",
  "types": "bindings/node",
  "keywords": [
    "incremental",
    "parsing",
    "tree-sitter",
    "groovy"
  ],
  "files": [
    "grammar.js",
    "tree-sitter.json",
    "binding.gyp",
    "prebuilds/**",
    "bindings/node/*",
    "queries/*",
    "src/**",
    "*.wasm"
  ],
  "dependencies": {
    "node-addon-api": "^8.2.1",
    "node-gyp-build": "^4.8.2"
  },
  "devDependencies": {
    "prebuildify": "^6.0.1",
    "tree-sitter-cli": "^0.24.7"
  },
  "peerDependencies": {
    "tree-sitter": "^0.21.1"
  },
  "peerDependenciesMeta": {
    "tree-sitter": {
      "optional": true
    }
  },
  "scripts": {
    "install": "node-gyp-build",
    "prestart": "tree-sitter build --wasm",
    "start": "tree-sitter playground",
    "generate": "tree-sitter generate",
    "build": "tree-sitter generate && node-gyp rebuild",
    "build:wasm": "tree-sitter build --wasm",
    "test:wasm": "tree-sitter test --wasm",
    "test": "tree-sitter test",
    "test:node": "node --test bindings/node/*_test.js"
  }
}