{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "groovy",
      "camelcase": "Groovy",
      "title": "Groovy",
      "scope": "source.groovy",
      "file-types": ["groovy", "gradle", "Jenkinsfile"]
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Groovy grammar for tree-sitter"
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true
  }
}
